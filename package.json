{
  "name": "@uptechworks/strapi-scheduled-content",
  "version": "0.1.0",
  "description": "Schedule publish and unpublish times for Strapi 5 content. Works locally and on Strapi Cloud, safe with multiple instances.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "scheduler",
    "publish",
    "strapi-cloud"
  ],
  "license": "MIT",
  "author": "Uptech Studio <jon@uptechstudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uptech/strapi-scheduled-content.git"
  },
  "homepage": "https://github.com/uptech/strapi-scheduled-content#readme",
  "bugs": {
    "url": "https://github.com/uptech/strapi-scheduled-content/issues"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.1",
    "@strapi/typescript-utils": "^5.61.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "scheduled-content",
    "displayName": "Scheduled Content",
    "description": "Schedule publish and unpublish times for draft & publish content."
  },
  "publishConfig": {
    "access": "public"
  }
}
